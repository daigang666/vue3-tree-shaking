{
  "name": "vue3-tree-shaking",
  "version": "1.2.1",
  "type": "module",
  "license": "GPL-3.0",
  "author": "gang.dai",
  "description": "Tree shaking for Vue 3 SFC - remove unused imports, variables and functions from <script setup>",
  "repository": {
    "type": "git",
    "url": "https://github.com/daigang666/vue3-tree-shaking"
  },
  "keywords": [
    "vue3",
    "tree-shaking",
    "sfc",
    "dead-code-elimination",
    "script-setup",
    "unused-imports"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.umd.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__standalone": "^7.1.7",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@babel/core": "^7.22.5",
    "@babel/standalone": "^7.25.3",
    "@vue/compiler-core": "^3.3.4",
    "@vue/compiler-sfc": "^3.3.4",
    "acorn": "^8.9.0",
    "acorn-walk": "^8.2.0"
  }
}
